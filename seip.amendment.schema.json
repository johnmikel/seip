{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seip.dev/schema/v1/amendment.schema.json",
  "title": "SEIP v1 Lifecycle Amendment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent": {
      "$ref": "#/$defs/IntentMergePatch"
    },
    "consumers": {
      "$ref": "#/$defs/ConsumerOperations"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {}
      }
    },
    {
      "type": "object",
      "required": [
        "consumers"
      ],
      "properties": {
        "consumers": {}
      }
    }
  ],
  "$defs": {
    "TeamId": {
      "title": "Team Identifier",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
    },
    "JsonValue": {
      "title": "JSON Value",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "IntentMergePatch": {
      "title": "Intent Merge Patch",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "DependencyList": {
      "title": "Consumer Dependencies",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "Consumer": {
      "title": "Consumer",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "team"
      ],
      "properties": {
        "team": {
          "$ref": "#/$defs/TeamId"
        },
        "contact": {
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/DependencyList"
        }
      },
      "not": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {}
        }
      }
    },
    "ConsumerUpdate": {
      "title": "Consumer Update",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team"
      ],
      "properties": {
        "team": {
          "$ref": "#/$defs/TeamId"
        },
        "contact": {
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/DependencyList"
        }
      }
    },
    "ConsumerOperations": {
      "title": "Consumer Amendment Operations",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Consumer"
          }
        },
        "update": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ConsumerUpdate"
          }
        }
      },
      "anyOf": [
        {
          "type": "object",
          "required": [
            "add"
          ],
          "properties": {
            "add": {}
          }
        },
        {
          "type": "object",
          "required": [
            "update"
          ],
          "properties": {
            "update": {}
          }
        }
      ]
    }
  }
}
