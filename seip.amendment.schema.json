{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seip.dev/schema/v1/amendment.schema.json",
  "title": "SEIP v1 Lifecycle Amendment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent": {
      "$ref": "#/$defs/IntentMergePatch"
    },
    "consumers": {
      "$ref": "#/$defs/ConsumerOperations"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {}
      }
    },
    {
      "type": "object",
      "required": [
        "consumers"
      ],
      "properties": {
        "consumers": {}
      }
    }
  ],
  "$defs": {
    "TeamId": {
      "title": "Team Identifier",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
    },
    "NonEmptyTrimmedString": {
      "title": "Non-empty Trimmed String",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
    },
    "NonEmptyString": {
      "title": "Non-empty String",
      "type": "string",
      "minLength": 1
    },
    "IntentSummary": {
      "title": "Intent Summary",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
    },
    "Timestamp": {
      "title": "RFC 3339 Timestamp",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
    },
    "JsonValue": {
      "title": "JSON Value",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "IntentMergePatch": {
      "title": "Intent Merge Patch",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntentSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyTrimmedString"
            },
            {
              "type": "null"
            }
          ]
        },
        "migration": {
          "anyOf": [
            {
              "$ref": "#/$defs/MigrationMergePatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeline": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimelineMergePatch"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "MigrationMergePatch": {
      "title": "Migration Merge Patch",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rollback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "TimelineMergePatch": {
      "title": "Timeline Merge Patch",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "review_deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_enforcement_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "deprecation_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "removal_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "DependencyList": {
      "title": "Consumer Dependencies",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "Consumer": {
      "title": "Consumer",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "team"
      ],
      "properties": {
        "team": {
          "$ref": "#/$defs/TeamId"
        },
        "contact": {
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/DependencyList"
        }
      },
      "not": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {}
        }
      }
    },
    "ConsumerUpdate": {
      "title": "Consumer Update",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team"
      ],
      "properties": {
        "team": {
          "$ref": "#/$defs/TeamId"
        },
        "contact": {
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/DependencyList"
        }
      },
      "anyOf": [
        {
          "type": "object",
          "required": [
            "contact"
          ],
          "properties": {
            "contact": {}
          }
        },
        {
          "type": "object",
          "required": [
            "dependencies"
          ],
          "properties": {
            "dependencies": {}
          }
        }
      ]
    },
    "ConsumerOperations": {
      "title": "Consumer Amendment Operations",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Consumer"
          }
        },
        "update": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ConsumerUpdate"
          }
        }
      },
      "anyOf": [
        {
          "type": "object",
          "required": [
            "add"
          ],
          "properties": {
            "add": {}
          }
        },
        {
          "type": "object",
          "required": [
            "update"
          ],
          "properties": {
            "update": {}
          }
        }
      ]
    }
  }
}
